# Copy to .env and fill in. Never commit the real file.
#
# Both keys are optional -- the simulation runs without them. They enable the
# two hosted features, and each reports itself as off when missing:
#   GET /api/voice/status  ->  {"backend": ..., "stt": {...}}

# Speech-to-text. Without it the mic button is disabled.
ABHYAS_DEEPGRAM_API_KEY=

# Hosted parser for sentences the local rules cannot place. Without it the
# parser is local-only, which still handles the documented vocabulary.
ABHYAS_LLM_API_KEY=
ABHYAS_LLM_MODEL=openai/gpt-oss-120b

# two_phase | four_phase
ABHYAS_PHASE_PLAN=four_phase

# Only needed for `docker compose --profile tls up`.
ABHYAS_DOMAIN=
